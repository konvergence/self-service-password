#!/bin/sh

DEBUG=${DEBUG:-}


## LDAP
LDAP_HOST=${LDAP_HOST:-ldap}
LDAP_PORT=${LDAP_PORT:-389}
LDAP_BASE=${LDAP_BASE:-dc=ldap,dc=example,dc=com}
if [ -z ${LDAP_BINDDN} ] ; then LDAP_BINDDN="cn=admin,${LDAP_BASE}"; fi
LDAP_BINDPWD=${LDAP_BINDPWD:-changeme}

if [ -z ${LDAP_DEFAULTPWDPOLICYDN} ] ; then LDAP_DEFAULTPWDPOLICYDN="cn=default,ou=policies,${LDAP_BASE}"; fi


## MAIL
SMTP_HOST=${SMTP_HOST:-smtp}
SMTP_PORT=${SMTP_PORT:-25}
SMTP_USER=${SMTP_USER:-}
SMTP_PASS=${SMTP_PASS:-}
SMTP_FROM=${SMTP_FROM:-root@localhost}
SMTP_SECURE=${SMTP_TLS:-tls}
SMTP_AUTH=${SMTP_TYPE:-true}



## LDAP-SSP
LSSP_PHRASE_KEY=${LSSP_PHRASE_KEY:-secret}
LSSP_MAIL_SUPPORT=${LSSP_MAIL_SUPPORT:-false}
LSSP_ATTR_LOGIN=${LSSP_ATTR_LOGIN:-uid}
LSSP_ATTR_FN=${LSSP_ATTR_FN:-cn}
LSSP_ATTR_MAIL=${LSSP_ATTR_MAIL:-mail}
LSSP_HASH_METHOD=${LSSP_HASH_METHOD:-auto}
LSSP_DEFAULT_ACTION=${LSSP_DEFAULT_ACTION:-change}


## reCAPTCHA
RECAPTCHA_USE=${RECAPTCHA_USE:-false};
RECAPTCHA_PUB_KEY=${RECAPTCHA_PUB_KEY};
RECAPTCHA_PRV_KEY=${RECAPTCHA_PRV_KEY};
RECAPTCHA_THEME=${RECAPTCHA_THEME:-white};
RECAPTCHA_SSL=${RECAPTCHA_USE:-false};


#apache2 vhost
VIRTUAL_SUBDIR=${VIRTUAL_SUBDIR:-lssp}